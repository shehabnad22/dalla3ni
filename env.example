# ===================================
# Dalla3ni Environment Configuration
# ===================================

# Backend (.env in /backend)
# --------------------------
PORT=3000
NODE_ENV=development

# Database Configuration
# For local development:
DATABASE_URL_LOCAL=postgresql://user:password@localhost:5432/dalla3ni
# For production (Render): DATABASE_URL is automatically set by Render
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API URL
# For local: http://localhost:3000
# For production: https://your-backend-url.onrender.com
API_URL=http://localhost:3000

# Allowed Origins (comma-separated)
# For local: http://localhost:3000,http://localhost:3001
# For production: https://your-admin-dashboard.com,https://your-mobile-app-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags
STORES_ENABLED=false
CENTERS_ENABLED=false

# Commission Settings
COMMISSION_AMOUNT=2500
DEBT_THRESHOLD=50

# Mobile App (.env in /mobile-app)
# --------------------------------
API_BASE_URL=http://localhost:3000/api
GOOGLE_MAPS_API_KEY=

# Admin Dashboard (.env in /admin-dashboard)
# ------------------------------------------
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_STORES_ENABLED=false

